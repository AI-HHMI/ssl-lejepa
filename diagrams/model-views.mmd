flowchart TB
    DL["miao loader"] -->|"vol: Batch C Z Y X"| VM["ViewMaker"]
    VM -->|"g_views: 2 x Batch C Zg Yg Xg"| ENC["ViT3DEncoder<br/>(one set of weights)"]
    VM -->|"l_views: 4 x Batch C Zl Yl Xl"| ENC
    ENC -->|"emb: View Batch D"| PJ["projector MLP"]
    PJ -->|"proj_globals: Global Batch Dproj"| MEAN["mean over globals"]
    PJ -->|"proj_all: View Batch Dproj"| SG["sigreg"]
    MEAN -->|"pred: View Batch Dproj"| LOSS["lejepa_loss<br/>error + lamb x SIGReg"]
    PJ -->|"target: View Batch Dproj"| LOSS
    SG -->|"sig: scalar"| LOSS
    LOSS -->|"loss: scalar"| OPT["backward<br/>AdamW"]
